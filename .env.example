# Fallback for the API key an agent uses when it and Settings both leave one unset.
OPENAI_API_KEY=
# Express port (the Vite dev server proxies /graphql here; agents reach /mcp directly).
PORT=8788
# Where the board lives. Left empty, the server runs postgres itself (PGlite) against ./data.
# A postgres:// URL points it at a postgres server instead; nothing else changes — see
# server/db/client.ts.
DATABASE_URL=
# DATABASE_URL=postgres://kanban:kanban@localhost:5432/kanban
# Optional. Empty -- the default -- leaves the server open to anyone who can reach the port,
# which is the right thing on a laptop and the wrong thing anywhere with a public IP. Set it and
# both /graphql and /mcp want `Authorization: Bearer <this>`; the web app asks for it once and
# keeps a cookie. Any long random string: `openssl rand -hex 32`.
KANBAN_SERVER_TOKEN=
