{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "paths": {
      "@/*": ["./web/*"],
      "@server/*": ["./server/*"],
      // agent-core and mcp-pool are linked from sibling checkouts, so each brings its own
      // `openai` alongside the one here. Two copies of a class with a `#private` field are two
      // nominal types, and an `OpenAI` built by the package is then not an `OpenAI` to us. They
      // declare it a peer dependency and mean it; this is where the peer is settled.
      "openai": ["./node_modules/openai"],
      "openai/*": ["./node_modules/openai/*"]
    }
  },
  "include": [
    "web",
    "server",
    "tests",
    "scripts",
    "vite.config.ts",
    "vitest.config.ts",
    "drizzle.config.ts",
    "codegen.ts"
  ]
}
